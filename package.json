{
  "name": "energy_dashboard",
  "version": "2.10.6",
  "description": "A private, self-hosted energy dashboard for Domoticz with Zonneplan dynamic pricing.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "npx playwright test",
    "test:visual:update": "npx playwright test --update-snapshots",
    "lint": "eslint scripts/ --max-warnings=0",
    "lint:fix": "eslint scripts/ --fix"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "vitest": "^4.1.5",
    "@playwright/test": "^1.62.0",
    "http-server": "^14.1.1"
  },
  "vitest": {
    "environment": "node",
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "lcov"
      ],
      "reportsDirectory": "./coverage"
    }
  },
  "private": true
}
